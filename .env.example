# Public site URL used for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Static ngrok domain for `npm run tunnel` (free at https://dashboard.ngrok.com/domains).
# Leave empty/commented to let ngrok pick a random URL each run.
# NGROK_DOMAIN=xxxx.ngrok-free.app

# No API keys are required.
# - Metadata: AniList GraphQL (public, server-side cached)
# - Streaming: AnimeParadise (public; episode tokens are IP-bound and
#   resolved in the browser, never stored on the server)
